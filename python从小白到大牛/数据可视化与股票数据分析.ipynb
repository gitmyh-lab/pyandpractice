   "source": [
    "import matplotlib.pyplot as plt\n",
    "#设置中文字体\n",
    "plt.rcParams['font.family'] = ['SimHei']\n",
    "x = [5, 4, 2 ,1]\n",
    "y = [7, 8, 9, 10]\n",
    "plt.plot(x, y, 'b', label='线1', linewidth=2)\n",
    "plt.title('绘制折线图')\n",
    "plt.ylabel('y轴')\n",
    "plt.xlabel('x轴')\n",
    "plt.legend()\n",
    "#以分辨率72来保存图片\n",
    "plt.savefig('折线图', dpi=72)\n",
    "plt.show()"
   ]
